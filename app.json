{
  "expo": {
    "name": "MomEase",
    "slug": "momease-care-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "momease",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDE5EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momease.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDE5EC"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.momease.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F472B6"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MomEase to use Face ID to unlock the app."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "supabaseUrl": "https://xvpoklpwdepwnawfekfu.supabase.co",
      "supabaseAnonKey": "sb_publishable_rkaEb4CTxTd3bxkOnvdlAA_uNekn2fL",
      "oauthRedirect": "https://oauth.lovable.app/callback",
      "router": {},
      "eas": {
        "projectId": "5931850e-959d-45b6-8b17-b7bf8a332841"
      }
    },
    "owner": "hansade"
  }
}
